# Spotify footer widget (optional) — create a Spotify app at
# developer.spotify.com, authorize with user-read-currently-playing +
# user-read-recently-played, exchange the code once for a refresh token
# (steps in README.md), then fill these in:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Preview the footer widget with sample data (no keys needed)
# SPOTIFY_DEMO=1

# Contact form (optional) — https://resend.com API key
RESEND_API_KEY=
